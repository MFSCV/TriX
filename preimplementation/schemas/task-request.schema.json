{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trix:proposed:schema:task-request:0.2",
  "title": "TriX 0.2 proposed single-task admission request",
  "description": "A bounded admission envelope for one task. Input/output type and operation references remain opaque here; no graph, source-language, canonical digest or authorization algorithm is defined.",
  "$comment": "Proposed TriX 0.2 companion contract. Structural validity is not implementation, authorization, compatibility, qualification or runtime evidence. This is not the complete TriX IR.",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "trix.task-request"
    },
    "schema_version": {
      "const": "0.2"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "principal_id": {
      "$ref": "#/$defs/id"
    },
    "workflow_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "submission_id": {
      "$ref": "#/$defs/id"
    },
    "plan_ref": {
      "$ref": "#/$defs/ref"
    },
    "input_revision_ref": {
      "$ref": "#/$defs/ref"
    },
    "operation": {
      "type": "object",
      "properties": {
        "operation_ref": {
          "$ref": "#/$defs/ref"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "contract_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "operation_ref",
        "version",
        "contract_ref"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "authentication_context_ref": {
          "$ref": "#/$defs/authContextRef"
        },
        "grant_refs": {
          "$ref": "#/$defs/authorityRefs"
        }
      },
      "required": [
        "authentication_context_ref",
        "grant_refs"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "type_ref": {
            "$ref": "#/$defs/ref"
          },
          "artifact_ref": {
            "$ref": "#/$defs/ref"
          }
        },
        "required": [
          "name",
          "type_ref",
          "artifact_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "type_ref": {
            "$ref": "#/$defs/ref"
          }
        },
        "required": [
          "name",
          "type_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "declared_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/$defs/namespaced"
          },
          "resource_refs": {
            "$ref": "#/$defs/refs"
          }
        },
        "required": [
          "kind",
          "resource_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "data_policy": {
      "type": "object",
      "properties": {
        "policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "classification_ref": {
          "$ref": "#/$defs/ref"
        },
        "allowed_destination_refs": {
          "$ref": "#/$defs/refs",
          "minItems": 1
        },
        "retention_policy_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "policy_ref",
        "classification_ref",
        "allowed_destination_refs",
        "retention_policy_ref"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "capability_refs": {
          "$ref": "#/$defs/refs"
        },
        "cpu_threads_min": {
          "$ref": "#/$defs/positiveCount64"
        },
        "memory_bytes_min": {
          "$ref": "#/$defs/count64"
        },
        "accelerator_memory_bytes_min": {
          "$ref": "#/$defs/count64"
        },
        "isolation_profile_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "capability_refs",
        "cpu_threads_min",
        "memory_bytes_min",
        "accelerator_memory_bytes_min",
        "isolation_profile_ref"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "wall_time_limit_ms": {
          "$ref": "#/$defs/positiveCount64"
        },
        "transfer_bytes_limit": {
          "$ref": "#/$defs/count64"
        },
        "financial_limit": {
          "$ref": "#/$defs/money"
        }
      },
      "required": [
        "wall_time_limit_ms",
        "transfer_bytes_limit",
        "financial_limit"
      ],
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "NEVER",
            "WHEN_SAFE"
          ]
        },
        "max_attempts": {
          "$ref": "#/$defs/positiveCount64"
        },
        "max_elapsed_ms": {
          "$ref": "#/$defs/positiveCount64"
        },
        "uncertain_effect_policy": {
          "const": "RECONCILE_BEFORE_RETRY"
        }
      },
      "required": [
        "mode",
        "max_attempts",
        "max_elapsed_ms",
        "uncertain_effect_policy"
      ],
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "required_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 0,
          "maxItems": 1024,
          "uniqueItems": true
        },
        "effect_obligations": {
          "const": "ALL_RESOLVED"
        },
        "verification_profile_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "required_outputs",
        "effect_obligations",
        "verification_profile_ref"
      ],
      "additionalProperties": false
    },
    "required_features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namespaced"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "tenant_id",
    "project_id",
    "principal_id",
    "workflow_id",
    "task_id",
    "submission_id",
    "plan_ref",
    "input_revision_ref",
    "operation",
    "authorization",
    "inputs",
    "outputs",
    "declared_effects",
    "data_policy",
    "requirements",
    "budget",
    "retry",
    "completion",
    "required_features"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "authRef": {
      "type": "string",
      "pattern": "^authref:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "authContextRef": {
      "type": "string",
      "pattern": "^authctx:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "namespaced": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9_]+)+$",
      "maxLength": 192
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
    },
    "count64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18})$",
      "$comment": "Nonnegative Int64 encoded in base ten. The companion semantic check enforces the upper bound 9223372036854775807."
    },
    "positiveCount64": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "$comment": "Positive Int64 encoded in base ten. The companion semantic check enforces the upper bound 9223372036854775807."
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 64,
      "$comment": "Exact nonnegative decimal text; no exponent or conversion through binary floating point."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "$comment": "This proposed record encoding uses a UTC timestamp subset, without leap-second encoding."
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[.-][a-z0-9_]+)+$": {
          "type": [
            "string",
            "boolean",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "authorityRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authRef"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 32
    },
    "money": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "mode": {
          "enum": [
            "STRICT",
            "ESTIMATED"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
