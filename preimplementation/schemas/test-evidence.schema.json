{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trix:proposed:schema:test-evidence:0.2",
  "title": "TriX 0.2 proposed test-evidence record",
  "description": "Records a test outcome without collapsing absent, blocked, inconclusive or inapplicable work into a pass. A pass requires an execution record and artifact references; this schema cannot authenticate those claims.",
  "$comment": "Proposed TriX 0.2 companion contract. Structural validity is not implementation, authorization, compatibility, qualification or runtime evidence. This is not the complete TriX IR.",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "trix.test-evidence"
    },
    "schema_version": {
      "const": "0.2"
    },
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "test_case_id": {
      "$ref": "#/$defs/id"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9]+$"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "result": {
      "enum": [
        "not-run",
        "pass",
        "fail",
        "blocked",
        "inconclusive",
        "not-applicable"
      ]
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "DOCUMENTATION_PACKAGE",
            "LANGUAGE_COMPILER",
            "RUNTIME",
            "SECURITY",
            "HARDWARE",
            "INTEGRATION"
          ]
        },
        "profile_refs": {
          "$ref": "#/$defs/refs"
        },
        "target_refs": {
          "$ref": "#/$defs/refs"
        },
        "artifact_revision_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "kind",
        "profile_refs",
        "target_refs",
        "artifact_revision_ref"
      ],
      "additionalProperties": false
    },
    "execution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "run_id": {
              "$ref": "#/$defs/id"
            },
            "started_at": {
              "$ref": "#/$defs/timestamp"
            },
            "ended_at": {
              "$ref": "#/$defs/timestamp"
            },
            "tool_ref": {
              "$ref": "#/$defs/ref"
            },
            "environment_ref": {
              "$ref": "#/$defs/ref"
            }
          },
          "required": [
            "run_id",
            "started_at",
            "ended_at",
            "tool_ref",
            "environment_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_ref": {
            "$ref": "#/$defs/ref"
          },
          "kind": {
            "enum": [
              "LOG",
              "REPORT",
              "TRACE",
              "SCREENSHOT",
              "DATASET"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_ref",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "applicability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "status",
        "rationale"
      ],
      "additionalProperties": false
    },
    "blocker_ref": {
      "$ref": "#/$defs/ref"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "evidence_id",
    "test_case_id",
    "requirement_ids",
    "result",
    "recorded_at",
    "scope",
    "execution",
    "artifacts",
    "summary",
    "applicability"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "not-run"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "null"
          },
          "artifacts": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object"
          },
          "artifacts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "blocked"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "blocker_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "not-applicable"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "null"
          },
          "applicability": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "applicability": {
            "properties": {
              "status": {
                "const": "APPLICABLE"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "authRef": {
      "type": "string",
      "pattern": "^authref:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "authContextRef": {
      "type": "string",
      "pattern": "^authctx:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "namespaced": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9_]+)+$",
      "maxLength": 192
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
    },
    "count64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18})$",
      "$comment": "Nonnegative Int64 encoded in base ten. The companion semantic check enforces the upper bound 9223372036854775807."
    },
    "positiveCount64": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "$comment": "Positive Int64 encoded in base ten. The companion semantic check enforces the upper bound 9223372036854775807."
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 64,
      "$comment": "Exact nonnegative decimal text; no exponent or conversion through binary floating point."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "$comment": "This proposed record encoding uses a UTC timestamp subset, without leap-second encoding."
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[.-][a-z0-9_]+)+$": {
          "type": [
            "string",
            "boolean",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "authorityRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authRef"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 32
    },
    "money": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "mode": {
          "enum": [
            "STRICT",
            "ESTIMATED"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
