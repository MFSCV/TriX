{
  "name":"trix-workflow","displayName":"TriX Workflow","version":"0.1.0","publisher":"trix-local","private":true,
  "description":"Plan bounded TriX work and inspect shared durable tasks.","engines":{"vscode":"^1.95.0"},"main":"./extension.cjs","extensionKind":["workspace"],
  "activationEvents":["onCommand:trix.planFromSelection","onCommand:trix.inspectProject","onCommand:trix.showTask","onCommand:trix.cancelTask","onCommand:trix.previewResult"],
