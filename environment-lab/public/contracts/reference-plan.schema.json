{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "effects",
    "tasks",
    "outputs"
  ],
  "properties": {
    "schema": {
      "const": "trix.reference-plan/v0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "effects": {
      "type": "array",
      "maxItems": 0
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-[A-Za-z0-9_-]{1,100}$"
          },
          "operation": {
            "enum": [
              "number.constant",
              "number.add",
              "number.multiply",
              "numbers.sum",
              "text.constant",
              "text.uppercase"
            ]
          },
          "args": {
            "type": "object",
            "maxProperties": 2,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 10000
                },
                {
                  "type": "array",
                  "maxItems": 1024,
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^task-[A-Za-z0-9_-]{1,100}$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^task-[A-Za-z0-9_-]{1,100}$"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriX experimental pure CPU reference plan",
  "description": "Structure only; operation-specific types and acyclic references are verified by the reference verifier."
}
