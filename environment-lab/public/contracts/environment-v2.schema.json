            "x86",
            "riscv64",
            "ppc64le",
            "s390x",
            "wasm32"
          ]
        },
        "os": {
          "enum": [
            "linux",
            "windows",
            "wsl2",
            "macos",
            "ios",
            "android",
            "browser",
            "freebsd"
          ]
        },
        "vendor": {
          "enum": [
            "amd",
            "intel",
            "apple",
            "qualcomm",
            "arm",
            "other"
          ]
        },
        "device": {
          "enum": [
            "cpu",
            "apple",
            "nvidia",
            "amd",
            "intel_gpu",
            "intel_npu",
            "qualcomm",
            "gaudi",
            "tpu",
            "neuron",
            "other"
          ]
        },
        "backend": {
          "enum": [
            "cpu",
            "onnx",
            "mlx",
            "coreml",
            "cuda",
            "rocm",
            "openvino",
            "directml",
            "qnn",
            "gaudi",
            "tpu",
            "neuron",
            "webgpu",
            "remote",
            "custom"
          ]
        },
        "ram": {
          "type": "number",
