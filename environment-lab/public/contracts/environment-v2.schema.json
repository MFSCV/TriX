          "minLength": 0,
          "maxLength": 200
        },
        "driver": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "backendVersion": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "groupId",
        "dependencies",
        "operation",
        "model",
        "modelVersion",
        "precision",
        "memory",
        "inputType",
        "outputType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^task-[A-Za-z0-9_-]{1,100}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 106
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 105
          }
        },
        "operation": {
          "enum": [
            "inference",
            "training",
            "tools"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "modelVersion": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "precision": {
          "enum": [
            "fp32",
            "fp16",
            "bf16",
            "int8",
            "int4"
          ]
        },
        "memory": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1048576
        },
        "inputType": {
          "enum": [
            "json",
            "tensor",
            "text",
            "artifact",
            "number"
          ]
        },
        "outputType": {
          "enum": [
            "json",
            "tensor",
            "text",
            "artifact",
            "number"
          ]
        }
      }
    }
  }
