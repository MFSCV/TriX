# Configure hosted secrets through Sites settings, never in chat or browser code.
# Provision OPENAI_API_KEY with the OpenAI Developers plugin approval workflow.
OPENAI_API_KEY=
TRIX_MODEL=
# JSON array. Operator-controlled HTTPS servers and exact tool grants.
# See docs/orchestrator-runtime.md for the contract. Tokens use separate secret keys.
TRIX_MCP_SERVERS=[]

# Optional server-only Supabase bridge. Configure both keys or leave both empty.
# URL format: https://<project-ref>.supabase.co (no trailing slash).
# Generate the bridge token in Vault and store its matching value as a Site secret.
# Never copy the Supabase service-role credential into the app or browser.
TRIX_SUPABASE_URL=
TRIX_SUPABASE_BRIDGE_TOKEN=
